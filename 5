    ]
}

def draw_number(num_str: str) -> list[str]:
    """Рисует число из звёздочек посимвольно, возвращает список строк (по одной на строку табло)."""
    lines = [""] * 5
    for ch in num_str:
        digit_lines = DIGITS.get(ch, ["     "] * 5)  # если символ не цифра — пустой блок
        for i in range(5):
            lines[i] += digit_lines[i] + "  "  # небольшой отступ между цифрами
    return lines

def draw_date(day: int, month: int, year: int) -> None:
    """Выводит дату в формате дд мм гггг, цифры — из звёздочек."""
    day_str = f"{day:02d}"
    month_str = f"{month:02d}"
    year_str = str(year)

    # Собираем строки для каждой части даты
    day_lines = draw_number(day_str)
    month_lines = draw_number(month_str)
    year_lines = draw_number(year_str)

    # Выводим построчно, добавляя пробелы между частями (дд  мм  гггг)
    for i in range(5):
        line = day_lines[i].rstrip() + "   " + month_lines[i].rstrip() + "   " + year_lines[i].rstrip()
        print(line)

# Ввод данных
try:
    day = int(input("Введите день рождения: "))
    month = int(input("Введите месяц рождения: "))
    year = int(input("Введите год рождения: "))

    # Простая проверка диапазона (можно усилить)
    if not (1 <= day <= 31 and 1 <= month <= 12 and year > 1900):
        raise ValueError("Некорректные значения даты.")

    print("\nДата рождения на электронном табло:\n")
    draw_date(day, month, year)

except ValueError as e:
    print(f"Ошибка: {e}")